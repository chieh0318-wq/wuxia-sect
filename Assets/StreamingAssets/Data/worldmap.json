{
  "bounds": { "lonMin": 70, "lonMax": 136, "latMin": 15, "latMax": 55 },
  "nodes": [
    { "id": "changan", "name": "長安", "lat": 34.27, "lon": 108.94, "type": "capital", "region": "關內道", "desc": "大唐西京，百萬人家。東市聚四方珍貨，西市多胡商酒肆，坊門暮鼓一響，全城閉戶。" },
    { "id": "huashan", "name": "華山", "lat": 34.48, "lon": 110.08, "type": "sect", "region": "關內道", "desc": "西嶽太華，削成四方。華嶽派據蓮花峰立派，殿宇連綿，香火極盛。" },
    { "id": "zhongnan", "name": "終南山", "lat": 34.06, "lon": 108.33, "type": "mountain", "region": "關內道", "desc": "長安南面的屏障，隱士與道觀遍布。樓觀說經台相傳為老子講《道德經》處。" },
    { "id": "taibai", "name": "太白山", "lat": 33.96, "lon": 107.77, "type": "mountain", "region": "關內道", "desc": "秦嶺主峰，六月積雪。山中多藥材，採藥人說，山頂的雪水能治百病。" },
    { "id": "tongguan", "name": "潼關", "lat": 34.57, "lon": 110.30, "type": "pass", "region": "關內道", "desc": "黃河拐彎處的天險，關中東門。過關的商旅都要驗過所。" },
    { "id": "lingzhou", "name": "靈州", "lat": 38.10, "lon": 106.30, "type": "city", "region": "關內道", "desc": "朔方軍駐地，黃河灌渠繞城，塞上江南。北去便是大漠。" },
    { "id": "shouxiang", "name": "中受降城", "lat": 40.60, "lon": 110.00, "type": "outpost", "region": "關內道", "desc": "黃河北岸三受降城之一，防備草原諸部南下的前哨。" },

    { "id": "luoyang", "name": "洛陽", "lat": 34.62, "lon": 112.45, "type": "capital", "region": "河南道", "desc": "大唐東都，天子常來就食。南市百貨雲集，漕船自通濟渠直抵城下。" },
    { "id": "xiaoshan", "name": "崤山", "lat": 34.62, "lon": 111.60, "type": "mountain", "region": "河南道", "desc": "扼兩京古道的群山，崤山劍門的舊山門所在。秦晉崤之戰，便打在這裡。" },
    { "id": "hangu", "name": "函谷關", "lat": 34.63, "lon": 110.87, "type": "pass", "region": "河南道", "desc": "古關舊址，車不方軌，馬不並轡。老子西出函谷，紫氣東來。" },
    { "id": "shanzhou", "name": "陝州", "lat": 34.77, "lon": 111.20, "type": "city", "region": "河南道", "desc": "兩京之間的大州，太原倉在此，漕糧由此轉運入關。" },
    { "id": "songshan", "name": "嵩山少林寺", "lat": 34.50, "lon": 112.94, "type": "sect", "region": "河南道", "desc": "中嶽少室山下的古剎。寺僧助太宗擒王世充有功，御賜田地，武名天下皆知。" },
    { "id": "funiu", "name": "伏牛山", "lat": 33.65, "lon": 111.90, "type": "sect", "region": "河南道", "desc": "豫西深山，伏牛劍派的山門。山下有戲班、武館，也有亡命之徒。" },
    { "id": "bianzhou", "name": "汴州", "lat": 34.80, "lon": 114.31, "type": "city", "region": "河南道", "desc": "通濟渠畔的水陸要衝，江淮的米與鹽，都從這裡北上西運。" },
    { "id": "taishan", "name": "泰山", "lat": 36.25, "lon": 117.10, "type": "mountain", "region": "河南道", "desc": "五嶽之首，天子封禪之地。開元年間的封禪大典，至今仍為人津津樂道。" },
    { "id": "dengzhou", "name": "登州", "lat": 37.80, "lon": 120.75, "type": "city", "region": "河南道", "desc": "渡海往新羅、渤海、日本的港口，海船上常有遣唐使與新羅商人。" },

    { "id": "taiyuan", "name": "太原", "lat": 37.87, "lon": 112.55, "type": "city", "region": "河東道", "desc": "大唐北都，高祖起兵之地。城高池深，晉陽宮舊址猶在。" },
    { "id": "puzhou", "name": "蒲州", "lat": 34.83, "lon": 110.33, "type": "city", "region": "河東道", "desc": "黃河東岸的河中重鎮，蒲津浮橋以鐵牛繫索，連通秦晉。" },
    { "id": "yanmen", "name": "雁門關", "lat": 39.18, "lon": 112.87, "type": "pass", "region": "河東道", "desc": "天下九塞之首。關外風沙，關內炊煙，一道城牆隔開兩個天下。" },
    { "id": "taihang", "name": "太行山", "lat": 36.20, "lon": 113.60, "type": "mountain", "region": "河東道", "desc": "八百里太行，陘道險絕。山寨林立，官軍剿了又生。" },

    { "id": "youzhou", "name": "幽州（范陽）", "lat": 39.90, "lon": 116.40, "type": "city", "region": "河北道", "desc": "范陽節度使治所，胡漢雜居，兵強馬壯。朝中有人說，這裡的兵只認節度使。" },
    { "id": "yingzhou", "name": "營州", "lat": 41.57, "lon": 120.45, "type": "outpost", "region": "河北道", "desc": "東北邊陲，契丹、奚、靺鞨諸部互市之所，六蕃語言在街上混雜。" },
    { "id": "weizhou", "name": "魏州", "lat": 36.28, "lon": 115.15, "type": "city", "region": "河北道", "desc": "河北大州，田畝豐饒，民風剽悍，豪俠與鹽販都不少。" },
    { "id": "dingzhou", "name": "定州（博陵）", "lat": 38.52, "lon": 114.99, "type": "city", "region": "河北道", "desc": "博陵崔氏的郡望。崔家莊園一眼望不到頭，連縣令都要看崔家臉色。" },
    { "id": "linyu", "name": "臨渝關", "lat": 40.00, "lon": 119.75, "type": "pass", "region": "河北道", "desc": "山海之間的關隘，出關便是遼西走廊。" },
    { "id": "cishan", "name": "磁山鐵冶", "lat": 36.50, "lon": 114.15, "type": "town", "region": "河北道", "desc": "太行東麓、滏水之濱的冶鐵之地。爐火不熄，鐵礦與石炭都挖得出。" },

    { "id": "xiangzhou", "name": "襄州", "lat": 32.01, "lon": 112.14, "type": "city", "region": "山南道", "desc": "漢水之畔的古城，南北通衢。峴山、鹿門山都在左近。" },
    { "id": "longzhong", "name": "隆中", "lat": 32.00, "lon": 112.03, "type": "town", "region": "山南道", "desc": "諸葛武侯躬耕之地。漢水灌田，良田千畝，村塾書聲不絕。" },
    { "id": "wudang", "name": "武當山", "lat": 32.40, "lon": 111.00, "type": "mountain", "region": "山南道", "desc": "太和山，五龍祠香火漸盛。道人在絕壁間結廬，練一種以柔克剛的拳。" },
    { "id": "jingzhou", "name": "荊州（江陵）", "lat": 30.35, "lon": 112.19, "type": "city", "region": "山南道", "desc": "長江中游重鎮，出三峽入蜀、順流下江東，都要經過這裡。" },
    { "id": "hanzhong", "name": "梁州（漢中）", "lat": 33.07, "lon": 107.02, "type": "city", "region": "山南道", "desc": "秦嶺與巴山之間的盆地，入蜀的咽喉，褒斜道與金牛道在此相接。" },

    { "id": "qinzhou", "name": "秦州", "lat": 34.58, "lon": 105.72, "type": "city", "region": "隴右道", "desc": "隴山以西第一州，出隴入涼的必經之地，麥積山石窟在其東南。" },
    { "id": "lintao", "name": "臨洮", "lat": 35.38, "lon": 103.86, "type": "outpost", "region": "隴右道", "desc": "洮河邊的軍城，與吐蕃犬牙交錯，烽燧夜夜不熄。" },
    { "id": "xiping", "name": "鄯州", "lat": 36.62, "lon": 101.78, "type": "city", "region": "隴右道", "desc": "隴右節度使治所，青海東門。唐蕃古道由此西南而去。" },
    { "id": "shibao", "name": "石堡城", "lat": 36.55, "lon": 101.20, "type": "outpost", "region": "隴右道", "desc": "赤嶺下的絕險孤城，唐與吐蕃反覆爭奪，城下白骨層層。" },
    { "id": "liangzhou", "name": "涼州", "lat": 37.93, "lon": 102.64, "type": "city", "region": "隴右道", "desc": "河西節度使治所，七城十萬戶，琵琶聲與駝鈴聲日夜不絕。" },
    { "id": "ganzhou", "name": "甘州", "lat": 38.93, "lon": 100.45, "type": "city", "region": "隴右道", "desc": "祁連山下的綠洲，水草豐美，軍馬多牧於此。" },
    { "id": "jiuquan", "name": "肅州（酒泉）", "lat": 39.74, "lon": 98.49, "type": "city", "region": "隴右道", "desc": "河西走廊西段，城東有泉，相傳霍去病傾御酒入泉，與將士共飲。" },
    { "id": "shazhou", "name": "沙州（敦煌）", "lat": 40.14, "lon": 94.66, "type": "city", "region": "隴右道", "desc": "鳴沙山下的佛國，莫高窟千佛洞燈火不絕。東西商旅在此補水歇腳。" },
    { "id": "yumen", "name": "玉門關", "lat": 40.35, "lon": 93.86, "type": "pass", "region": "隴右道", "desc": "春風不度之地。出了玉門，便是西域。" },
    { "id": "yizhou", "name": "伊州", "lat": 42.83, "lon": 93.51, "type": "town", "region": "隴右道", "desc": "莫賀延磧的那一頭，西域第一站。瓜甜如蜜，風沙如刀。" },
    { "id": "gaochang", "name": "西州（高昌）", "lat": 42.85, "lon": 89.53, "type": "city", "region": "隴右道", "desc": "火焰山下的故國，葡萄架下坐著漢人、粟特人和回紇人。" },
    { "id": "beiting", "name": "北庭", "lat": 44.02, "lon": 89.20, "type": "outpost", "region": "隴右道", "desc": "天山以北的都護府，瀚海軍駐此，冬日雪深沒馬。" },
    { "id": "qiuci", "name": "龜茲", "lat": 41.72, "lon": 82.96, "type": "city", "region": "隴右道", "desc": "安西都護府治所，安西四鎮之首。龜茲樂舞名動長安。" },
    { "id": "shule", "name": "疏勒", "lat": 39.47, "lon": 75.99, "type": "city", "region": "隴右道", "desc": "安西四鎮最西，蔥嶺腳下。翻過山去，便是大食與吐火羅。" },
    { "id": "yutian", "name": "于闐", "lat": 37.11, "lon": 79.93, "type": "city", "region": "隴右道", "desc": "安西四鎮之一，崑崙山下出美玉，尉遲王族世代奉佛。" },
    { "id": "suiye", "name": "碎葉", "lat": 42.80, "lon": 75.20, "type": "outpost", "region": "隴右道", "desc": "熱海以西的孤城，曾為安西四鎮之一，今為突騎施牙帳所據。" },

    { "id": "huihe_ya", "name": "回紇牙帳", "lat": 47.40, "lon": 102.70, "type": "outpost", "region": "漠北", "desc": "鄂爾渾河畔的草原王庭。氈帳連綿，馬群如雲。" },

    { "id": "yangzhou", "name": "揚州", "lat": 32.39, "lon": 119.42, "type": "city", "region": "淮南道", "desc": "揚一益二。運河與長江交匯，鹽商富甲天下，二十四橋夜夜笙歌。" },

    { "id": "suzhou", "name": "蘇州", "lat": 31.30, "lon": 120.62, "type": "city", "region": "江南道", "desc": "水巷縱橫的吳中名城，絲帛與稻米的富庶之鄉。" },
    { "id": "hangzhou", "name": "杭州", "lat": 30.25, "lon": 120.17, "type": "city", "region": "江南道", "desc": "錢塘江口，西湖之畔。八月觀潮，弄潮兒踏浪而行。" },
    { "id": "mogan", "name": "莫干山", "lat": 30.60, "lon": 119.87, "type": "mountain", "region": "江南道", "desc": "吳越之間的竹海，相傳干將莫邪於此鑄劍，劍池猶在。" },
    { "id": "yuezhou", "name": "越州", "lat": 30.00, "lon": 120.58, "type": "city", "region": "江南道", "desc": "會稽古城，越窯青瓷如千峰翠色，鏡湖水清見底。" },
    { "id": "tiantai", "name": "天台山", "lat": 29.13, "lon": 121.03, "type": "mountain", "region": "江南道", "desc": "國清寺與赤城山相望，佛道兩家在此各據一峰。" },
    { "id": "yishan", "name": "黟山", "lat": 30.13, "lon": 118.17, "type": "mountain", "region": "江南道", "desc": "歙州奇峰，雲海常年不散。山腳湯泉四季溫熱。" },
    { "id": "hongzhou", "name": "洪州", "lat": 28.68, "lon": 115.89, "type": "city", "region": "江南道", "desc": "贛水之畔，滕王閣臨江而立。南下嶺南的商旅在此換船。" },
    { "id": "tanzhou", "name": "潭州", "lat": 28.20, "lon": 112.97, "type": "city", "region": "江南道", "desc": "湘江邊的大州，嶽麓山在對岸，橘子洲橫在江心。" },
    { "id": "hengshan", "name": "衡山", "lat": 27.25, "lon": 112.65, "type": "mountain", "region": "江南道", "desc": "南嶽，七十二峰。回雁峰下，北雁至此不再南飛。" },

    { "id": "chengdu", "name": "益州（成都）", "lat": 30.66, "lon": 104.06, "type": "city", "region": "劍南道", "desc": "天府之國，錦官城。蜀錦、蜀紙、蜀茶，樣樣都是好買賣。" },
    { "id": "emei", "name": "峨眉山", "lat": 29.52, "lon": 103.33, "type": "mountain", "region": "劍南道", "desc": "蜀中名山，普賢道場。金頂雲海之上，偶見佛光。" },
    { "id": "jianmen", "name": "劍門關", "lat": 32.20, "lon": 105.55, "type": "pass", "region": "劍南道", "desc": "一夫當關，萬夫莫開。入蜀的金牛道在此穿過七十二峰。" },
    { "id": "songzhou", "name": "松州", "lat": 32.65, "lon": 103.60, "type": "outpost", "region": "劍南道", "desc": "岷江上游的邊城，與吐蕃接壤，羌人、党項人雜居。" },
    { "id": "fuyi", "name": "富義鹽井", "lat": 29.18, "lon": 104.98, "type": "town", "region": "劍南道", "desc": "瀘州富義監，汲鹵煮鹽，蜀中鹽商雲集。" },

    { "id": "guangzhou", "name": "廣州", "lat": 23.13, "lon": 113.26, "type": "city", "region": "嶺南道", "desc": "南海大港，市舶使駐此。大食、波斯、天竺的海船泊滿珠江。" },
    { "id": "guizhou", "name": "桂州", "lat": 25.27, "lon": 110.29, "type": "city", "region": "嶺南道", "desc": "灕江繞城，奇峰如筍。靈渠溝通湘灕，是嶺南入中原的水路。" },
    { "id": "jiaozhou", "name": "交州", "lat": 21.03, "lon": 105.85, "type": "city", "region": "嶺南道", "desc": "安南都護府治所，大唐最南的州郡，象牙、沉香、珍珠都從這裡北運。" },

    { "id": "taihe", "name": "太和城", "lat": 25.62, "lon": 100.20, "type": "city", "region": "南詔", "desc": "洱海之濱，蒙舍詔的都城。六詔歸一的消息，正從這裡傳開。" },
    { "id": "luoxie", "name": "邏些", "lat": 29.65, "lon": 91.13, "type": "capital", "region": "吐蕃", "desc": "吐蕃贊普的都城，紅山宮殿高踞城中。唐蕃和親的公主，曾從長安遠嫁至此。" }
  ],
